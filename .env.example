# Zkopíruj jako .env a doplň. Vše je volitelné.

# Zdarma na https://www.travelpayouts.com/ (Developers → API token) – přidá stovky dalších aerolinek.
TRAVELPAYOUTS_TOKEN=
# Affiliate (nepovinné): marker = ID účtu, TRS = číslo projektu (app.travelpayouts.com → Profile → Sources).
# Až s oběma se odkazy na Aviasales, Booking.com a DiscoverCars převedou na partnerské (tp.media) a označí „reklama“.
# Projekt musí být v těchto programech přihlášený. Jen s markerem dostane marker pouze odkaz na Aviasales.
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=
# Trh Aviasales, z jehož vyhledávání se berou ceny (výchozí cz).
TRAVELPAYOUTS_MARKET=cz

# Kiwi.com (živé ceny všech aerolinek k vybranému letu, bez klíče). 0 = vypnout.
KIWI_ENABLED=1

# Hotely s cenou a hodnocením hostů: zdarma klíč na https://dashboard.liteapi.travel
# (sand_… = testovací data; ostrý klíč = skutečné ceny, vyžaduje kartu, ale neplatí se nic).
LITEAPI_KEY=
# Volitelně vlastní rezervační white-label stránka LiteAPI (např. atlas.nuitee.link).
LITEAPI_WHITELABEL=

PORT=8080
# Kolik nejbližších letišť prohledat v jednom hledání.
MAX_ORIGINS=8
# Kolik dotazů na trasy Wizz Air smí jedno hledání „kamkoliv“ udělat.
WIZZ_MAX_CALLS=60
# Max. počet hledání z jedné IP za 10 minut (0 = bez limitu).
SEARCH_RATE_LIMIT=40
# Vlak/bus místo letadla: živé spoje RegioJetu (jen ze serveru, na vyžádání). 0 = jen odhad a odkazy.
REGIOJET_LIVE=1
# Nejvýš tolik dotazů na RegioJet za hodinu.
REGIOJET_MAX_PER_HOUR=60
# Ceny paliva pro cestu autem na letiště (ČSÚ, Oil Bulletin EU, 1× denně). 0 = vestavěné ceny bez sítě.
FUEL_LIVE=1
# 1 = vymyšlená demo data
ATLAS_MOCK=0
