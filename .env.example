# Zkopíruj jako .env a doplň. Vše je volitelné.

# Zdarma na https://www.travelpayouts.com/ (Developers → API token) – přidá stovky dalších aerolinek.
TRAVELPAYOUTS_TOKEN=
# Affiliate (nepovinné): marker = ID účtu, TRS = číslo projektu (app.travelpayouts.com → Profile → Sources).
# Až s oběma se odkazy na Aviasales, Booking.com a DiscoverCars převedou na partnerské (tp.media) a označí „reklama“.
# Projekt musí být v těchto programech přihlášený. Jen s markerem dostane marker pouze odkaz na Aviasales.
TRAVELPAYOUTS_MARKER=
TRAVELPAYOUTS_TRS=
# Trh Aviasales, z jehož vyhledávání se berou ceny (výchozí cz).
TRAVELPAYOUTS_MARKET=cz

# Kiwi.com (živé ceny všech aerolinek k vybranému letu, bez klíče). 0 = vypnout.
KIWI_ENABLED=1

# Hotely s cenou a hodnocením bez klíče: TripAdvisor přes neoficiální API Xotelo (orientační ceny, bez provizí).
# Používá se, když není ostrý klíč LiteAPI. off = vypnout (zůstanou odkazy na partnery).
XOTELO=on
# Hotely s cenou a hodnocením hostů: zdarma klíč na https://dashboard.liteapi.travel – má přednost před Xotelem
# (sand_… = testovací data, pak Xotelo; ostrý klíč = skutečné ceny, vyžaduje kartu, ale neplatí se nic; umožní provize).
LITEAPI_KEY=
# Volitelně vlastní rezervační white-label stránka LiteAPI (např. atlas.nuitee.link).
LITEAPI_WHITELABEL=
# Odkazy na Trip.com, Agodu a Hostelworld s termínem a hosty: server u nich jednou dohledá ID místa
# (na místo a partnera jeden dotaz, v mezipaměti 30 dní). 0 = bez dotazů, odkazy jen s názvem místa.
PARTNER_LOOKUP=1
# Hezčí fotky měst na kartách (volitelné, zdarma): Pexels (nové klíče teď nevydává) nebo Unsplash –
# unsplash.com/developers → Your apps → New Application → Access Key. Bez klíčů fotky z Wikimedie.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
# Mapy.com (volitelné, zdarma 250 000 kreditů měsíčně): turistická mapa u tras pěšky a na kole, hledání vesnic a míst
# v Objevuj, záloha plánovače tras. Účet Seznam → developer.mapy.com → Můj účet → Projekty → Nový projekt → API klíč.
MAPY_API_KEY=
# Strop kreditů Mapy.com za hodinu (dlaždice 1, hledání / trasa 4); 340 ≈ 245 000 měsíčně, pod volnými kredity.
MAPY_MAX_PER_HOUR=340

PORT=8080
# Kolik nejbližších letišť prohledat v jednom hledání.
MAX_ORIGINS=8
# Kolik dotazů na trasy Wizz Air smí jedno hledání „kamkoliv“ udělat.
WIZZ_MAX_CALLS=60
# Max. počet hledání z jedné IP za 10 minut (0 = bez limitu).
SEARCH_RATE_LIMIT=40
# Vlak/bus místo letadla: živé spoje RegioJetu (jen ze serveru, na vyžádání). 0 = jen odhad a odkazy.
REGIOJET_LIVE=1
# Nejvýš tolik dotazů na RegioJet za hodinu.
REGIOJET_MAX_PER_HOUR=60
# Ceny paliva pro cestu autem na letiště (ČSÚ, Oil Bulletin EU, 1× denně). 0 = vestavěné ceny bez sítě.
FUEL_LIVE=1
# Adresa pro 💬 Napsat nám v ℹ️ O aplikaci a soukromí (volitelné; prázdné = tlačítko se neukáže).
FEEDBACK_EMAIL=
# 1 = vymyšlená demo data
ATLAS_MOCK=0
